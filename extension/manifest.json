{
  "manifest_version": 3,
  "name": "Snag UI",
  "version": "0.1.0",
  "description": "Pick any element on a page and turn its HTML + CSS into a compact React component (Tailwind or CSS Modules).",
  "action": {
    "default_title": "Snag UI — pick an element (Alt+Shift+S)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Start picking an element"
    }
  }
}
